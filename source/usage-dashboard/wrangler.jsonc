{
  "name": "3dsrp-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"ALLOWED_EMAIL": "maintainer@example.invalid"},
  "observability": {"enabled": false, "logs": {"enabled": false, "invocation_logs": false, "persist": false}, "traces": {"enabled": false}},
  "d1_databases": [{"binding": "DB", "database_name": "3dsrp-usage", "database_id": "00000000-0000-0000-0000-000000000000"}],
  "access": {"dev": {"aud": "3dsrp-dashboard-local", "identity": {"email": "maintainer@example.invalid"}}}
}
